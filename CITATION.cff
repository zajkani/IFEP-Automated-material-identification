    orcid: "https://orcid.org/0000-0003-3718-9807"
version: "1.0.0"
date-released: "2026-11-20"
license: MIT
repository-code: "https://github.com/zajkani/IFEP-Automated-material-identification"
keywords:
  - material parameter identification
  - evolutionary programming
  - fast evolutionary programming
  - creep damage
  - constitutive modeling
  - inverse problems
  - MATLAB
